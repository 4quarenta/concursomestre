{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://concursomestre.com/contracts/seo/seo-production-page-map.v1.schema.json",
  "title": "SEO Production Page Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultLaunchMode", "families"],
  "properties": {
    "version": { "const": "seo-production-page-map.v1" },
    "defaultLaunchMode": { "$ref": "https://concursomestre.com/contracts/seo/seo-launch-control.v1.schema.json#/definitions/launchMode" },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "familyId",
          "routeFamily",
          "routePatterns",
          "currentState",
          "familyEligibility",
          "preLaunchIndexability",
          "targetProductionIndexability",
          "sitemapTarget",
          "instanceReadinessRule",
          "launchStatus",
          "robotsFollow"
        ],
        "properties": {
          "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "routeFamily": { "type": "string", "minLength": 1 },
          "routePatterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^/" }
          },
          "currentState": {
            "enum": ["INDEX", "NOINDEX", "MIXED", "NOT_CREATED", "REDIRECT", "PRIVATE"]
          },
          "familyEligibility": { "$ref": "https://concursomestre.com/contracts/seo/seo-launch-control.v1.schema.json#/definitions/familyEligibility" },
          "preLaunchIndexability": { "const": "NOINDEX" },
          "targetProductionIndexability": { "enum": ["INDEX", "NOINDEX"] },
          "sitemapTarget": { "enum": ["INCLUDE_WHEN_READY", "EXCLUDE"] },
          "instanceReadinessRule": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "launchStatus": { "enum": ["ACTIVE", "PILOT", "PLANNED", "PERMANENT"] },
          "robotsFollow": { "type": "boolean" },
          "requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
