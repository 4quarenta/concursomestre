{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.next/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@constants": [
        "./src/constants/index.ts"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@types": [
        "./src/types/index.ts"
      ],
      "types": [
        "./src/types/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "strict": false
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.d.ts",
    ".next/dev/types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile",
    "docs",
    "scripts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
