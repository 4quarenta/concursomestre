{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@constants": [
        "src/constants/index.ts"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@providers/*": [
        "src/providers/*"
      ],
      "@constants/*": [
        "src/constants/*"
      ],
      "@types": [
        "src/types/index.ts"
      ],
      "types": [
        "src/types/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
