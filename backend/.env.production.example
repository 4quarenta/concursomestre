# ConcursoMestre backend production template.
# Copy to backend/.env and replace every CHANGE_ME value. Never commit backend/.env.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com
APP_VERSION=CHANGE_ME_RELEASE_VERSION
APP_RELEASE_COMMIT=CHANGE_ME_RELEASE_COMMIT
APP_TIMEZONE=America/Sao_Paulo
OBSERVABILITY_REQUEST_LOG_ENABLED=true
LEGACY_ENDPOINT_SUNSET_HTTP_DATE=
LEGACY_ENDPOINT_ENFORCE_SUNSET=false
LEGACY_ENDPOINT_ZERO_CONSUMER_ALIASES=
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=concursomestre
DB_USER=concursomestre_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_TIMEOUT_SECONDS=5
DB_PERSISTENT=false

# Optional read replica. Leave DB_READ_HOST empty to read from the primary.
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_NAME=concursomestre
DB_READ_USER=
DB_READ_PASSWORD=
DB_READ_TIMEOUT_SECONDS=5
DB_READ_PERSISTENT=false

# Public uploads. Use local until an S3/R2 bucket and CDN hostname exist.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_PUBLIC_BASE_URL=/uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
API_KEY=CHANGE_ME_WITH_AT_LEAST_48_RANDOM_CHARACTERS
CRON_SECRET=CHANGE_ME_WITH_AT_LEAST_48_RANDOM_CHARACTERS

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_SERVICE_ID=

STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_ACCOUNT_ID=
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_PIX_ACCOUNT_ID=
STRIPE_PAYMENT_RETRY_DELAYS_SECONDS=3600,86400,259200
STRIPE_PAYMENT_RETRY_MAX_ATTEMPTS=4
FINANCIAL_RECONCILIATION_ALLOW_REPAIR=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=mailer@example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ConcursoMestre

REDIS_ENABLED=true
REDIS_REQUIRED=true
APP_INSTANCE_COUNT=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PREFIX=concursomestre:production:
REDIS_CONNECT_TIMEOUT=1.5
REDIS_READ_TIMEOUT=1.5

STRIPE_PAYMENT_RETRY_DELAYS_SECONDS=3600,86400,259200
STRIPE_PAYMENT_RETRY_MAX_ATTEMPTS=4
STRIPE_WEBHOOK_WORKER_MAX_ATTEMPTS=8
STRIPE_WEBHOOK_ASYNC_ENABLED=true
QUESTIONS_PUBLIC_CACHE_TTL=60
QUESTIONS_SCALE_COLUMNS_READY=false
QUESTIONS_SEARCH_DOCUMENTS_READY=false

PRIVATE_INGESTION_CLIENTS_JSON={"local-client":{"token":"CHANGE_ME_INGESTION_TOKEN","hmac_secret":"CHANGE_ME_INGESTION_HMAC_SECRET","actor_user_id":"CHANGE_ME_ADMIN_USER_ID"}}

MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql
BACKUP_DIR=/var/backups/concursomestre/mysql
BACKUP_RETENTION_DAYS=14

AI_PROVIDER=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

MIGRATIONS_ALLOW_APPLY=false
MIGRATIONS_ALLOW_PRODUCTION=false
