# ConcursoMestre Phase 13R PITR target for the current single-primary Percona 8.4 host.
# Install only through the approved 13-X change after a verified recovery backup.

[mysqld]
innodb_flush_log_at_trx_commit=1
sync_binlog=1
log_bin=concursomestre-bin
binlog_format=ROW
binlog_expire_logs_seconds=604800
server-id=130001

# GTID is intentionally OFF: there is no replication topology in the current
# architecture, and PITR uses file/position replay.
gtid_mode=OFF
enforce_gtid_consistency=OFF
