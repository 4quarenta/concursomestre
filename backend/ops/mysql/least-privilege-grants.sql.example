-- ConcursoMestre Phase 13R principal contract.
-- Replace placeholders only in the approved 13-X operational change.
-- This file never contains users, hosts or passwords from production.

-- Runtime application. Existing schema is a precondition; DDL is denied.
GRANT SELECT, INSERT, UPDATE, DELETE
ON `concursomestre`.*
TO 'concursomestre_runtime'@'<approved-runtime-host>';

-- Backup. --no-tablespaces avoids PROCESS; --single-transaction avoids LOCK TABLES.
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT
ON `concursomestre`.*
TO 'concursomestre_backup'@'<approved-backup-host>';
GRANT SHOW_ROUTINE
ON *.*
TO 'concursomestre_backup'@'<approved-backup-host>';

-- Read-only operational audit.
GRANT SELECT, SHOW VIEW
ON `concursomestre`.*
TO 'concursomestre_readonly'@'<approved-readonly-host>';

-- Migration operator. This principal is not used by HTTP/runtime processes.
GRANT SELECT, INSERT, UPDATE, DELETE,
      CREATE, ALTER, DROP, INDEX, REFERENCES,
      CREATE VIEW, SHOW VIEW, TRIGGER, EVENT,
      CREATE ROUTINE, ALTER ROUTINE, EXECUTE,
      CREATE TEMPORARY TABLES, LOCK TABLES
ON `concursomestre`.*
TO 'concursomestre_migration'@'<approved-migration-host>';

-- No principal above receives ALL PRIVILEGES or GRANT OPTION.
