[Unit]
Description=Materialize ConcursoMestre blog and Google News sitemaps
After=network-online.target mysql.service

[Service]
Type=oneshot
User=concursomestre
Group=concursomestre
WorkingDirectory=/home/concursomestre/htdocs/concursomestre.com
EnvironmentFile=/etc/concursomestre/backend.env.production
ExecStart=/usr/bin/php backend/scripts/seo/generate_static_blog_sitemaps.php
NoNewPrivileges=true
PrivateTmp=true
