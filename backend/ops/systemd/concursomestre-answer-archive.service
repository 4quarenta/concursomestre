[Unit]
Description=Archive old ConcursoMestre answer attempts
After=network-online.target mysql.service

[Service]
Type=oneshot
User=concursomestre
Group=concursomestre
WorkingDirectory=/home/concursomestre/htdocs/concursomestre.com
EnvironmentFile=/etc/concursomestre/backend.env.production
ExecStart=/usr/bin/php backend/scripts/maintenance/archive_user_answers.php --apply --days=730 --batch-size=1000 --max-batches=25
NoNewPrivileges=true
PrivateTmp=true
