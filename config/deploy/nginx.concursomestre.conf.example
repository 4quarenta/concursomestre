# Ajuste os server_name, certificados, socket PHP e caminhos antes de usar.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.com;

    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    # O crawler administrativo aceita ate 5.000 questoes em uma unica submissao.
    # Os jobs internos continuam limitados a 15 MB no worker.
    client_max_body_size 128m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Nunca exponha diretorios de implementacao, a rota legada do backend ou
    # instaladores/diagnosticos. A API publica entra somente por /api/.
    location = /questao-pro-backend {
        return 404;
    }

    location ^~ /questao-pro-backend/ {
        return 404;
    }

    location ~ ^/(?:questao-pro-backend|backend)/(?:config|database|modules|scripts|storage|runtime|vendor|tests)(?:/|$) {
        return 404;
    }

    location ~ ^/(config|database|modules|scripts|storage|runtime|vendor|tests)/ {
        deny all;
        return 404;
    }

    location ~ ^/api/(?:setup|internal|debug|tests?|scripts|storage|runtime|vendor)(?:/|$) {
        return 404;
    }

    location = /api/setup/install.php {
        return 404;
    }

    # O FastAPI/PyMuPDF e um worker interno. O browser nao pode chamar a porta
    # ou esta rota diretamente; a API PHP deve orquestrar a extracao.
    location ^~ /import-extractor/ {
        internal;
        proxy_pass http://127.0.0.1:8010/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/.+\.php$ {
        root /var/www/questao-pro-backend;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 120s;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location /api/ {
        root /var/www/questao-pro-backend;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
