# Copie para /etc/concursomestre/deploy.env e proteja com chmod 0640.
# Segredos permanecem nos arquivos de ambiente apontados abaixo.
CM_ENVIRONMENT=staging
CM_RELEASES_DIR=/var/www/releases/concursomestre
CM_FRONTEND_LINK=/var/www/concursomestre
CM_BACKEND_LINK=/var/www/questao-pro-backend
CM_SHARED_DIR=/var/www/shared/concursomestre
CM_FRONTEND_ENV_SOURCE=/etc/concursomestre/frontend.env.production
CM_BACKEND_ENV_SOURCE=/etc/concursomestre/backend.env.production
CM_FRONTEND_SERVICE=concursomestre-web.service
CM_PHP_FPM_SERVICE=php8.3-fpm.service
CM_NGINX_SERVICE=nginx.service
CM_APP_GROUP=www-data
CM_KEEP_RELEASES=5
CM_DEPLOY_LOCK_FILE=/var/lock/concursomestre/deploy.lock
CM_DEPLOY_STATE_DIR=/var/lib/concursomestre/deploy
CM_WEB_BASE_URL=https://staging.seu-dominio.com
CM_API_BASE_URL=https://staging.seu-dominio.com/api
CM_SMOKE_TIMEOUT_SECONDS=15
