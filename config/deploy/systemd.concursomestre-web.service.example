[Unit]
Description=ConcursoMestre Next.js frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/concursomestre
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/etc/concursomestre/frontend.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
