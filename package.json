{
  "name": "concursomestre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "web-next:dev": "npm run dev",
    "web-next:build": "npm run build",
    "web-next:start": "npm run start",
    "web-next:typecheck": "npm run typecheck",
    "web-next:cutover-check": "node scripts/checks/web-next-cutover-check.mjs",
    "web-next:legacy-bridge-check": "node scripts/checks/web-next-legacy-bridge-check.mjs",
    "web-next:hybrid-local-check": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-hybrid-local-check.ps1",
    "web-next:hybrid-local-report": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-hybrid-local-report.ps1",
    "web-next:cutover-handoff": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-cutover-handoff.ps1",
    "web-next:legacy-bridge-report": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-legacy-bridge-check.ps1",
    "web-next:cutover-report": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-cutover-report.ps1",
    "web-next:staging-gate": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-staging-gate.ps1",
    "web-next:stage4-init-config": "powershell -ExecutionPolicy Bypass -File scripts/checks/new-web-next-stage4-rollout-config.ps1",
    "web-next:stage4-status": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-status.ps1",
    "web-next:stage4-readiness": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-status.ps1 -RequireMacro5Ready",
    "web-next:stage4-proxy-check": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-proxy-check.ps1",
    "web-next:stage4-smoke": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-smoke.ps1",
    "web-next:stage4-config-check": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-rollout.ps1 -ValidateOnly",
    "web-next:stage4-rollout": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-rollout.ps1",
    "web-next:stage4-handoff": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage4-handoff.ps1",
    "web-next:stage5-init-config": "powershell -ExecutionPolicy Bypass -File scripts/checks/new-web-next-stage5-launch-config.ps1",
    "web-next:stage5-validate": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage5-launch.ps1 -ValidateOnly",
    "web-next:stage5-launch": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage5-launch.ps1",
    "web-next:stage5-status": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage5-status.ps1",
    "web-next:stage5-readiness": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage5-status.ps1 -RequireCompleted",
    "web-next:stage5-smoke": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-stage5-smoke.ps1",
    "web-next:production-gate": "powershell -ExecutionPolicy Bypass -File scripts/checks/run-web-next-staging-gate.ps1 -Environment production",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "test:headers": "powershell -ExecutionPolicy Bypass -File scripts/checks/verify-standard-file-header.ps1",
    "check:text-encoding": "node scripts/checks/check-mojibake.mjs",
    "fix:text-encoding": "node scripts/checks/fix-mojibake.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
