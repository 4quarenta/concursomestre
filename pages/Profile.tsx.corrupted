<form onSubmit= async (e) => e.preventDefault() if (passwordForm.new !== passwordForm.confirm) addToast('As senhas não coincidem.', 'error') return if (passwordForm.new.length < 6) addToast('A nova senha deve ter pelo menos 6 caracteres.', 'error') return setIsUpdatingPassword(true) try const res: any = await apiClient.post('users/update.php', password: passwordForm.new ) if (res.success) addToast('Senha atualizada com sucesso!', 'success') setShowPasswordModal(false) setPasswordForm( current: '', new: '', confirm: '' ) catch (err) addToast('Erro ao atualizar senha.', 'error') finally setIsUpdatingPassword(false) className="p-6 space-y-4">
