{
  "expo": {
    "name": "ConcursoMestre",
    "slug": "concursomestre-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.concursomestre.mobile"
    },
    "android": {
      "package": "com.concursomestre.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost/questao-pro-backend/api/"
    }
  }
}
